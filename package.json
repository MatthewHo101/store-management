{
  "name": "coffee-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-business coffee operations from bean procurement to customer fulfillment",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "migrate": "tsx src/cli.ts migrate",
    "demo": "tsx src/cli.ts demo",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
